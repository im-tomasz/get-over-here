<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Physical pixel coordinates on every monitor (required when monitors use different scale factors). -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>GetOverHere</AssemblyName>
    <RootNamespace>GetOverHere</RootNamespace>
    <Version>1.1.0</Version>
    <Product>Get Over Here!</Product>
    <AssemblyTitle>Get Over Here!</AssemblyTitle>
    <Description>Keeps the mouse cursor and keyboard focus on the main screen when touching the secondary touch screen (SuperDisplay).</Description>
    <NoWarn>$(NoWarn);SYSLIB1054</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Icon of the executable (Explorer, taskbar, Alt+Tab). Generated by Assets/make-icons.ps1. -->
    <ApplicationIcon>Assets\GetOverHere.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Notification-area icons, loaded at runtime by AppIcons. -->
    <EmbeddedResource Include="Assets\GetOverHere.ico" LogicalName="GetOverHere.Assets.GetOverHere.ico" />
    <EmbeddedResource Include="Assets\GetOverHere-paused.ico" LogicalName="GetOverHere.Assets.GetOverHere-paused.ico" />
    <EmbeddedResource Include="Assets\GetOverHere-dark.ico" LogicalName="GetOverHere.Assets.GetOverHere-dark.ico" />
    <EmbeddedResource Include="Assets\GetOverHere-dark-paused.ico" LogicalName="GetOverHere.Assets.GetOverHere-dark-paused.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GetOverHere.Tests" />
  </ItemGroup>

</Project>
